{
	"name": "my-images",
	"version": "1.0.0",
	"description": "Keeps the notes of the image folders in shape — naming their images after them, dating them after the tweet they link to.",
	"main": "main.js",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian"
	],
	"author": "Vlad Kostyanetsky",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
